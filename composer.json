{
    "name": "omnischolar/arxiv",
    "type": "library",
    "description": "Omnischolar arXiv: preprints by author name, arXiv id or search, with abstracts, categories, PDFs and the DOI of the published version - no key, three seconds between calls.",
    "keywords": [
        "scholarly",
        "publications",
        "arxiv",
        "preprints",
        "physics",
        "omnischolar"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "omnisense/omnischolar": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnischolar\\Arxiv\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnischolar\\Arxiv\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
